<odoo>
    <!--    Form view of doctor-->
    <record id="appointment_view_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_draft" type="object" string="Draft"
                            invisible="stage in ['draft','confirmed','done']" class="btn-warning"/>
                    <button name="action_confirmed" type="object" string="Confirm"
                            invisible="stage in ['confirmed','done','cancel']" class="btn-info"/>
                    <button name="action_done" type="object" string="Done"
                            invisible="stage in ['draft','cancel','done']" class="btn-success"/>
                    <button name="cancel_wizard" type="object" string="Cancelled" invisible="stage in ['cancel']"
                            class="btn-danger"/>
                    <field name="stage" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group >
                        <group>
                            <field name="patient_id" readonly="stage != 'draft'"/>
                            <field name="patient_age" readonly="stage != 'draft'"/>
                            <field name="appointment_date" readonly="stage != 'draft'"/>
                            <field name="reason" readonly="stage != 'draft'"/>
                        </group>
                        <group>
                            <field name="doctor_id" readonly="stage != 'draft'"/>
                            <field name="doctor_fee" readonly="stage != 'draft'"/>
                            <field name="appointment_time" readonly="stage != 'draft'"/>
                            <field name="notes" readonly="stage != 'draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--kanban view-->
    <record id="view_appointment_kanban" model="ir.ui.view">
        <field name="name">appointment.kanban</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="respect_patient_name"/>
                <field name="patient_age"/>
                <field name="appointment_time"/>
                <field name="doc_respect_name"/>
                <field name="appointment_date"/>
                <field name="stage"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click  ">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title" style="font-size: 1.2rem;">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <hr class="mt-2 mb-2"/>
                            <div>
                                <div>
                                    <strong>Patient name :-</strong>
                                    <field name="respect_patient_name"/>
                                </div>
                                <div>
                                    <strong>Age :-</strong>
                                    <field name="patient_age"/>
                                </div>
                                <div>
                                    <strong>Appointment on :-</strong>
                                    <field name="appointment_time"/>
                                </div>
                                <div>
                                    <strong>Name of Doctor :-</strong>
                                    <field name="doc_respect_name"/>
                                </div>
                                <div>
                                    <strong>Date of Appointment :-</strong>
                                    <field name="appointment_date"/>
                                </div>
                                <div>
                                    <field name="stage" widget="badge" decoration-warning="stage == 'draft'"
                                           decoration-success="stage == 'done'" decoration-danger="stage == 'cancel'"
                                           decoration-info="stage == 'confirmed'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--    List view-->
    <record id="appointment_view_list" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list class="my_doctor_list">
                <field name="respect_patient_name"/>
                <field name="patient_age" string='Age' class="patients_age_list"/>
                <field name="appointment_time"/>
                <field name="appointment_date"/>
                <field name="doc_respect_name"/>
                <field name="reason"/>
                <field name="stage" widget="badge" decoration-warning="stage == 'draft'"
                       decoration-success="stage == 'done'" decoration-danger="stage == 'cancel'"
                       decoration-info="stage == 'confirmed'"/>
            </list>
        </field>
    </record>
    <record id="hospital_appointment_search" model="ir.ui.view">
        <field name="name">hospital.appointment.search</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="respect_patient_name" string="Patient Name"/>
                <field name="doc_respect_name" string="Docter Name"/>
                <filter string="Draft" name="draft" domain="[('stage', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('stage', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('stage', '=', 'done')]"/>
                <filter string="Cancelled" name="cancel" domain="[('stage', '=', 'cancel')]"/>
                <group expand="0" string="Group By">
                    <filter string="Stages" name="stage by" context="{'group_by': 'stage'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--    Action Window-->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem id="menu_hospital_appointment" name="appointment" parent="patient_management.menu_my_detail" sequence="3"
              action="action_hospital_appointment"/>
</odoo>