<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="Sequence_patients" model="ir.sequence">
        <field name="name">Patients Order</field>
        <field name="code">patients.seq.order</field>
        <field name="prefix">P-S/</field>
        <field name="padding">5</field>
    </record>

    <record id="sequence_docters" model="ir.sequence">
        <field name="name">Docters Order</field>
        <field name="code">docters.seq.order</field>
        <field name="prefix">D-S/</field>
        <field name="padding">5</field>
    </record>

    <record id="sequence_apoinment" model="ir.sequence">
        <field name="name">Apoinment Order</field>
        <field name="code">apoinment.seq.order</field>
        <field name="prefix">O-R/</field>
        <field name="padding">5</field>
    </record>


</odoo>