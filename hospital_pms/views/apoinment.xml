<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="apoinment_form" model="ir.ui.view">
        <field name="name">Patients apoinment set</field>
        <field name="model">hospital.apoinment</field>
        <field name="arch" type="xml">
            <form>
                <field name="patient_rec"/>
            </form>
        </field>
    </record>

    <record id="apoinment_list" model="ir.ui.view">
        <field name="name">Apoinment.list</field>
        <field name="model">hospital.apoinment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="apoin_order" string="Order"/>
                <field name="docters_pic" widget="image" options="{'size': [100, 90]}" string="Dr's Photo"/>
                <field name="docters_rec"/>
                <field name="patients_pic" widget="image" options="{'size': [100, 90]}" string="Patients Photo"/>
                <field name="patient_rec"/>
                <field name="apoin"/>
            </list>
        </field>
    </record>


    <record id="action_apoinment" model="ir.actions.act_window">
        <field name="name">Apoinment</field>
        <field name="res_model">hospital.apoinment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first appointment!
            </p>
        </field>
    </record>

    <menuitem id="menu_apoinment" name="Apoinments" parent="menu_hospital_pms_record" action="action_apoinment"
              sequence="3"/>
</odoo>