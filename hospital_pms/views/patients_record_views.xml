<odoo>
    <record id="view_Patients_form" model="ir.ui.view">
        <field name="name">patients.form</field>
        <field name="model">hospital.patients</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <div class="oe_title">
                                <h2>
                                    <field name="sequence_patients" readonly="1"/>
                                </h2>
                            </div>
                            <field name="name"/>
                            <field name="dob"/>
                            <field name="gender" widget="radio"/>
                            <field name="phone_number"/>
                        </group>
                        <group>
                            <field name="category_filter" string="Disease_Category"/>
                            <field name="master_ids" string="Disease" domain="[('datatype', '=', category_filter)]"/>
                            <field name="image_1920"/>
                            <field name="priview"/>
                            <div invisible="not priview" class="mt-2">
                                <field name="image_1920" widget="image" readonly="1" options="{'size': [60, 80]}"
                                       class="oe_avatar"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_Patients_list" model="ir.ui.view">
        <field name="name">Patients.list</field>
        <field name="model">hospital.patients</field>
        <field name="arch" type="xml">
            <list decoration-info="not active">
                <field name="sequence_patients" string="Order-of-Patients"/>
                <field name="name"/>
                <field name="gender" widget="badge" decoration-success="gender == 'Male'"
                       decoration-warning="gender == 'Female'"/>
                <field name="master_ids" string="Disease"/>
                <field name="phone_number" widget="phone"/>
                <field name="status_text" widget="badge"
                       decoration-success="status_text == 'active'"
                       decoration-danger="status_text == 'inactive'"
                       readonly="1" width="120px"/>
                <field name="active" widget="boolean_toggle" width="50px"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patients_search" model="ir.ui.view">
        <field name="name">hospital.patients.search</field>
        <field name="model">hospital.patients</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Patient Name"/>
                <filter string="DisCharge Patients" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="On Treatment Patients" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Gender" name="group_by_gender" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_Patients_kanban" model="ir.ui.view">
        <field name="name">Patients.kanban</field>
        <field name="model">hospital.patients</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click d-flex">
                            <div class="o_kanban_image me-3">
                                <field name="image_1920" class="oe_avatar" widget="image"
                                       options="{'size': [115, 150]}"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/><strong> (</strong>
                                    <field name="sequence_patients"/><strong>)</strong>


                                </strong>
                                <field name="gender" widget="badge" decoration-success="gender == 'Male'"
                                       decoration-warning="gender == 'Female'"
                                       style="display: inline-block; position: absolute; left: 40px; bottom: 15px; padding: 0px 31px 0px 28px; "/>
                                <p>
                                    <strong style="font-size:12px;">
                                        <field name="master_ids" string="Disease"/>
                                    </strong>

                                </p>
                                <field name="phone_number" widget="phone" style="font-weight:bold;"/>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_right d-flex align-items-center"
                                         t-attf-style="gap:8px; padding:11px 8px 4px 7px; border-radius:5px;#{record.active.raw_value == True ? 'background-color: #e6fffa;' : 'background-color: #fff5f5;'}">
                                        <strong t-if="record.active.raw_value" style="color: #28a745;">● Treatment On
                                        </strong>
                                        <strong t-if="!record.active.raw_value" style="color: #dc3545;">○ DisCharge
                                        </strong>
                                        <field name="active" widget="boolean_toggle" style="transform: rotate(90deg);"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_patients_new" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patients</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first patient!</p>
        </field>
    </record>

    <menuitem id="menu_hospital_pms_root" name="HMS" sequence="1"/>
    <menuitem id="menu_hospital_pms_record" name="RECORD" parent="menu_hospital_pms_root" sequence="1"/>
    <menuitem id="menu_pms" name="PMS" parent="menu_hospital_pms_record" action="action_patients_new" sequence="1"/>
</odoo>